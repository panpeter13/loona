  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:dev": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config index.js",
    "check": "node --check index.js && node --check test-db.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test:kakao": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config test-kakao.js",
    "test:prediction": "node test-prediction.js",
    "test:db": "DOTENV_CONFIG_PATH=.env.local node test-db.js",
    "test": "npm run check && npm run test:prediction && npm run test:kakao && npm run test:db"
  },
